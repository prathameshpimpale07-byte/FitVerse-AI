						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Prathmesh Pimpale\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"age\": 22,\n  \"gender\": \"male\",\n  \"height\": 178,\n  \"weight\": 75,\n  \"fitnessGoal\": \"Muscle Gain\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
